# MongoDB Atlas 配置
# 访问 https://www.mongodb.com/atlas 注册免费账户
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/moodtreehole?retryWrites=true&w=majority

# JWT密钥（生产环境请使用更复杂的密钥）
JWT_SECRET=your_jwt_secret_change_me

# DeepSeek API密钥（可选，有免费额度）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Groq API密钥（推荐，完全免费）
# 获取地址：https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here



# 服务器端口
PORT=3000

# Node环境
NODE_ENV=development
